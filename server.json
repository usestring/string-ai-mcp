{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.usestring/web-access",
  "title": "String Web Access",
  "description": "Search the web, fetch any URL and map a site — clean Markdown, past anti-bot blocks.",
  "repository": {
    "url": "https://github.com/usestring/string-ai-mcp",
    "source": "github"
  },
  "websiteUrl": "https://usestring.ai",
  "version": "1.3.2",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@usestring/mcp",
      "version": "1.3.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "STRING_AI_API_KEY",
          "description": "Your String API key (get one at portal.usestring.ai)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.usestring.ai/v1/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <your String API key>",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
