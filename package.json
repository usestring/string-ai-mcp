{
  "name": "@usestring/mcp",
  "mcpName": "ai.usestring/web-access",
  "version": "1.2.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Official String Web Access MCP server — search the web, fetch or write to any URL, and map a site's URLs as clean, LLM-ready Markdown, with anti-bot handling, CAPTCHAs and JS rendering server-side.",
  "type": "module",
  "bin": {
    "string-ai-mcp": "build/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "string-ai",
    "web-scraping",
    "web-access",
    "model-context-protocol",
    "mcp-server",
    "web-search",
    "markdown",
    "anti-bot",
    "captcha",
    "proxy",
    "crawler",
    "data-extraction",
    "llm",
    "ai-agents",
    "claude",
    "cursor",
    "unblocker"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usestring/string-ai-mcp.git"
  },
  "homepage": "https://github.com/usestring/string-ai-mcp#readme",
  "bugs": {
    "url": "https://github.com/usestring/string-ai-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "typescript": "^5.8.0"
  }
}
